{
  "source": "D:\\整体视频流程重建\\素材库\\对标账号视频\\复利研习社\\06_7669265304576745299.mp4",
  "language": "zh",
  "language_probability": 1,
  "duration": 197.2549375,
  "segments": [
    {
      "start": 0.0,
      "end": 1.92,
      "text": "还在天天做梦一夜报复吗?"
    },
    {
      "start": 1.92,
      "end": 2.56,
      "text": "醒醒吧"
    },
    {
      "start": 2.56,
      "end": 3.68,
      "text": "普通人想翻身"
    },
    {
      "start": 3.68,
      "end": 4.96,
      "text": "靠的从来不是运气"
    },
    {
      "start": 4.96,
      "end": 6.28,
      "text": "也不是无效的拼命"
    },
    {
      "start": 6.28,
      "end": 7.88,
      "text": "而是这两个字 稳妇"
    },
    {
      "start": 7.88,
      "end": 9.04,
      "text": "接下来这三分钟"
    },
    {
      "start": 9.04,
      "end": 10.56,
      "text": "可能有点颠覆你的认知"
    },
    {
      "start": 10.56,
      "end": 11.84,
      "text": "甚至会得罪很多人"
    },
    {
      "start": 11.84,
      "end": 13.32,
      "text": "但我建议你点赞收藏"
    },
    {
      "start": 13.32,
      "end": 14.92,
      "text": "找个安静的地方反复看"
    },
    {
      "start": 14.92,
      "end": 17.04,
      "text": "你有没有发现一个非常扎心的现象"
    },
    {
      "start": 17.04,
      "end": 17.88,
      "text": "越是穷的人"
    },
    {
      "start": 17.88,
      "end": 19.0,
      "text": "越喜欢买彩票"
    },
    {
      "start": 19.0,
      "end": 20.0,
      "text": "越是没钱的人"
    },
    {
      "start": 20.0,
      "end": 21.4,
      "text": "越容易被那些零投入"
    },
    {
      "start": 21.4,
      "end": 23.44,
      "text": "越入十万的低级片局割韭菜"
    },
    {
      "start": 23.44,
      "end": 24.0,
      "text": "为什么?"
    },
    {
      "start": 24.0,
      "end": 25.64,
      "text": "因为太渴望改变现状了"
    },
    {
      "start": 25.64,
      "end": 26.4,
      "text": "太急躁了"
    },
    {
      "start": 26.4,
      "end": 27.52,
      "text": "太想走捷径了"
    },
    {
      "start": 27.52,
      "end": 28.24,
      "text": "你总想着"
    },
    {
      "start": 28.24,
      "end": 29.36,
      "text": "今天投进去一万"
    },
    {
      "start": 29.36,
      "end": 30.8,
      "text": "明天就能赚回十万"
    },
    {
      "start": 30.8,
      "end": 32.28,
      "text": "后天就能提保世界"
    },
    {
      "start": 32.28,
      "end": 32.92,
      "text": "结果呢"
    },
    {
      "start": 32.92,
      "end": 34.04,
      "text": "你不仅没赚到钱"
    },
    {
      "start": 34.04,
      "end": 35.6,
      "text": "连辛辛苦苦攒下的本金"
    },
    {
      "start": 35.6,
      "end": 36.64,
      "text": "都被人捐跑了"
    },
    {
      "start": 36.64,
      "end": 37.44,
      "text": "这个世界上"
    },
    {
      "start": 37.44,
      "end": 38.32,
      "text": "凡是那些宣称"
    },
    {
      "start": 38.32,
      "end": 39.92,
      "text": "能让你快速赚大钱的方法"
    },
    {
      "start": 39.92,
      "end": 41.2,
      "text": "全都写在刑法里"
    },
    {
      "start": 41.2,
      "end": 42.76,
      "text": "凡是那些主动找上门来"
    },
    {
      "start": 42.76,
      "end": 44.24,
      "text": "热情的要带你发财的人"
    },
    {
      "start": 44.24,
      "end": 45.28,
      "text": "全都是把你当成了"
    },
    {
      "start": 45.28,
      "end": 46.32,
      "text": "他发财的工具"
    },
    {
      "start": 46.32,
      "end": 47.12,
      "text": "他们盯上的"
    },
    {
      "start": 47.12,
      "end": 47.92,
      "text": "就是你口袋里"
    },
    {
      "start": 47.92,
      "end": 49.16,
      "text": "那点可怜的本金"
    },
    {
      "start": 49.16,
      "end": 50.24,
      "text": "成年人必须明白"
    },
    {
      "start": 50.24,
      "end": 51.36,
      "text": "一个残酷的真相"
    },
    {
      "start": 51.36,
      "end": 51.92,
      "text": "快钱"
    },
    {
      "start": 51.92,
      "end": 53.16,
      "text": "普通人是赚不到的"
    },
    {
      "start": 53.16,
      "end": 54.08,
      "text": "就算你运气好"
    },
    {
      "start": 54.08,
      "end": 54.96,
      "text": "偶然赚到了"
    },
    {
      "start": 54.96,
      "end": 55.84,
      "text": "凭你的认知"
    },
    {
      "start": 55.84,
      "end": 56.92,
      "text": "你也绝对守不住"
    },
    {
      "start": 56.92,
      "end": 58.8,
      "text": "市场会有一万种方法收割你"
    },
    {
      "start": 58.8,
      "end": 60.6,
      "text": "真正能让你实现阶层月遷的"
    },
    {
      "start": 60.6,
      "end": 61.32,
      "text": "从来不是什么"
    },
    {
      "start": 61.32,
      "end": 62.84,
      "text": "惊天动地的报复神话"
    },
    {
      "start": 62.84,
      "end": 64.04,
      "text": "而是那些慢功夫"
    },
    {
      "start": 64.04,
      "end": 64.88,
      "text": "是那种看起来"
    },
    {
      "start": 64.88,
      "end": 66.6,
      "text": "甚至有点笨笨的稳负策略"
    },
    {
      "start": 66.6,
      "end": 67.68,
      "text": "很多人瞧不上一年"
    },
    {
      "start": 67.68,
      "end": 69.2,
      "text": "百分之五百分之八的文件"
    },
    {
      "start": 69.2,
      "end": 69.8,
      "text": "收益率"
    },
    {
      "start": 69.8,
      "end": 70.68,
      "text": "觉得太慢了"
    },
    {
      "start": 70.68,
      "end": 71.48,
      "text": "要猴年马月"
    },
    {
      "start": 71.48,
      "end": 72.72,
      "text": "才能买房买车"
    },
    {
      "start": 72.72,
      "end": 73.88,
      "text": "但爱因斯坦说过"
    },
    {
      "start": 73.88,
      "end": 75.64,
      "text": "复利是世界第八大奇迹"
    },
    {
      "start": 75.64,
      "end": 76.44,
      "text": "你以为的慢"
    },
    {
      "start": 76.44,
      "end": 78.2,
      "text": "其实在时间维度的加持下"
    },
    {
      "start": 78.2,
      "end": 79.24,
      "text": "才是真正的快"
    },
    {
      "start": 79.24,
      "end": 80.4,
      "text": "如果你想彻底洗脑"
    },
    {
      "start": 80.4,
      "end": 82.4,
      "text": "自己那套根深蒂固的穷人思维"
    },
    {
      "start": 82.4,
      "end": 83.68,
      "text": "如果你想在这个浮躁的"
    },
    {
      "start": 83.68,
      "end": 84.88,
      "text": "让人窒息的时代里"
    },
    {
      "start": 84.88,
      "end": 85.76,
      "text": "找到一条真正"
    },
    {
      "start": 85.76,
      "end": 87.28,
      "text": "适合普通人的支付之路"
    },
    {
      "start": 87.28,
      "end": 88.88,
      "text": "你一定要看看这本稳妇"
    },
    {
      "start": 88.88,
      "end": 89.56,
      "text": "说实话"
    },
    {
      "start": 89.56,
      "end": 91.12,
      "text": "一开始看到书名稳妇"
    },
    {
      "start": 91.12,
      "end": 92.12,
      "text": "我觉得挺土的"
    },
    {
      "start": 92.12,
      "end": 93.16,
      "text": "没啥吸引力"
    },
    {
      "start": 93.16,
      "end": 95.2,
      "text": "但我耐着性子读了十几页之后"
    },
    {
      "start": 95.2,
      "end": 96.48,
      "text": "我大腿都拍肿了"
    },
    {
      "start": 96.48,
      "end": 97.48,
      "text": "相见恨晚了"
    },
    {
      "start": 97.48,
      "end": 99.52,
      "text": "为什么没人早点告诉我这些道理"
    },
    {
      "start": 99.52,
      "end": 100.44,
      "text": "这本书简直就是"
    },
    {
      "start": 100.44,
      "end": 101.72,
      "text": "一把锋利的手术刀"
    },
    {
      "start": 101.72,
      "end": 102.84,
      "text": "极其精准地切开了"
    },
    {
      "start": 102.84,
      "end": 103.6,
      "text": "我们身上那些"
    },
    {
      "start": 103.6,
      "end": 104.76,
      "text": "导致贫穷的毒瘤"
    },
    {
      "start": 104.76,
      "end": 105.6,
      "text": "急功尽力"
    },
    {
      "start": 105.6,
      "end": 106.36,
      "text": "盲目跟风"
    },
    {
      "start": 106.36,
      "end": 107.24,
      "text": "毫无财商"
    },
    {
      "start": 107.24,
      "end": 109.2,
      "text": "他没有教你怎么去捕捉什么腰骨"
    },
    {
      "start": 109.2,
      "end": 110.92,
      "text": "也没有教你怎么去投机导把"
    },
    {
      "start": 110.92,
      "end": 112.16,
      "text": "他只教你一件事"
    },
    {
      "start": 112.16,
      "end": 113.24,
      "text": "怎么把你手里那些"
    },
    {
      "start": 113.24,
      "end": 114.44,
      "text": "你看不上的小钱"
    },
    {
      "start": 114.44,
      "end": 115.8,
      "text": "通过极其合理的规划"
    },
    {
      "start": 115.8,
      "end": 117.16,
      "text": "和长期主义的坚持"
    },
    {
      "start": 117.16,
      "end": 118.36,
      "text": "变成一笔庞大的"
    },
    {
      "start": 118.36,
      "end": 120.28,
      "text": "足以支撑你晚年生活的财富"
    },
    {
      "start": 120.28,
      "end": 122.04,
      "text": "吻富里讲到一个核心概念"
    },
    {
      "start": 122.04,
      "end": 123.16,
      "text": "深深地集中了"
    },
    {
      "start": 123.16,
      "end": 125.16,
      "text": "很多人的财富积累之所以失败"
    },
    {
      "start": 125.16,
      "end": 127.12,
      "text": "是因为他们把投资当成了赌博"
    },
    {
      "start": 127.12,
      "end": 128.32,
      "text": "赌博是靠运气"
    },
    {
      "start": 128.32,
      "end": 129.48,
      "text": "而真正的投资"
    },
    {
      "start": 129.52,
      "end": 130.76,
      "text": "是一场胜利游戏"
    },
    {
      "start": 130.76,
      "end": 131.52,
      "text": "你需要做的是"
    },
    {
      "start": 131.52,
      "end": 133.24,
      "text": "不断做大概率正确的事情"
    },
    {
      "start": 133.24,
      "end": 134.84,
      "text": "然后把剩下的交给时间"
    },
    {
      "start": 134.84,
      "end": 135.92,
      "text": "书里详细拆解了"
    },
    {
      "start": 135.92,
      "end": 137.04,
      "text": "如何科学的规划"
    },
    {
      "start": 137.04,
      "end": 138.4,
      "text": "你每个月的死工资"
    },
    {
      "start": 138.4,
      "end": 139.76,
      "text": "从几点的日常记账"
    },
    {
      "start": 139.76,
      "end": 140.96,
      "text": "到资金池的划分"
    },
    {
      "start": 140.96,
      "end": 142.6,
      "text": "再到傻瓜式的定头策略"
    },
    {
      "start": 142.6,
      "end": 144.56,
      "text": "他把那些灰色难懂的金融数语"
    },
    {
      "start": 144.56,
      "end": 145.48,
      "text": "全部揉碎了"
    },
    {
      "start": 145.48,
      "end": 146.88,
      "text": "变成了咱们普通老百姓"
    },
    {
      "start": 146.88,
      "end": 147.64,
      "text": "一听就懂"
    },
    {
      "start": 147.64,
      "end": 148.92,
      "text": "一看就会的大白话"
    },
    {
      "start": 148.92,
      "end": 150.08,
      "text": "你看完就会发现"
    },
    {
      "start": 150.08,
      "end": 151.32,
      "text": "原来理财这么简单"
    },
    {
      "start": 151.32,
      "end": 152.72,
      "text": "原来只要你不瞎折腾"
    },
    {
      "start": 152.72,
      "end": 154.36,
      "text": "顺着时间的方向慢慢走"
    },
    {
      "start": 154.36,
      "end": 156.32,
      "text": "你也能成为那个最终有钱的人"
    },
    {
      "start": 156.32,
      "end": 156.92,
      "text": "朋友们"
    },
    {
      "start": 156.92,
      "end": 158.24,
      "text": "别再为自己赚不到钱"
    },
    {
      "start": 158.24,
      "end": 159.52,
      "text": "找大环境的借口了"
    },
    {
      "start": 159.52,
      "end": 160.76,
      "text": "你只是差一个正确的"
    },
    {
      "start": 160.76,
      "end": 162.04,
      "text": "财富导师来典型你"
    },
    {
      "start": 162.04,
      "end": 163.8,
      "text": "左下角小黄车里的这本稳妇"
    },
    {
      "start": 163.8,
      "end": 166.16,
      "text": "就是你人生中最好的理财启蒙老师"
    },
    {
      "start": 166.16,
      "end": 166.96,
      "text": "你现在去外面"
    },
    {
      "start": 166.96,
      "end": 168.32,
      "text": "报个什么理财速成班"
    },
    {
      "start": 168.32,
      "end": 169.4,
      "text": "动辄几千上万"
    },
    {
      "start": 169.4,
      "end": 170.52,
      "text": "全是花式套路"
    },
    {
      "start": 170.52,
      "end": 171.6,
      "text": "而这本原汁原味"
    },
    {
      "start": 171.6,
      "end": 172.64,
      "text": "干货满满的书"
    },
    {
      "start": 172.64,
      "end": 173.72,
      "text": "只需要你几包烟"
    },
    {
      "start": 173.72,
      "end": 174.84,
      "text": "两杯奶茶的钱"
    },
    {
      "start": 174.84,
      "end": 175.8,
      "text": "少抽两包烟"
    },
    {
      "start": 175.8,
      "end": 176.64,
      "text": "不会对你的生活"
    },
    {
      "start": 176.64,
      "end": 178.12,
      "text": "有任何实质性的影响"
    },
    {
      "start": 178.12,
      "end": 179.08,
      "text": "但这本稳妇"
    },
    {
      "start": 179.08,
      "end": 180.76,
      "text": "也许能让你在未来五年内"
    },
    {
      "start": 180.76,
      "end": 181.76,
      "text": "多存下十万"
    },
    {
      "start": 181.76,
      "end": 182.36,
      "text": "二十万"
    },
    {
      "start": 182.36,
      "end": 184.48,
      "text": "甚至改变你整个家族的财富基因"
    },
    {
      "start": 184.48,
      "end": 186.32,
      "text": "不要在最该积累认知的时候"
    },
    {
      "start": 186.32,
      "end": 187.72,
      "text": "选择了躺平和抱怨"
    },
    {
      "start": 187.72,
      "end": 189.0,
      "text": "点击下方小黄车"
    },
    {
      "start": 189.0,
      "end": 190.16,
      "text": "把这本书买回去"
    },
    {
      "start": 190.16,
      "end": 191.2,
      "text": "放在你的枕边"
    },
    {
      "start": 191.2,
      "end": 192.56,
      "text": "每天睡前读十分钟"
    },
    {
      "start": 192.56,
      "end": 194.04,
      "text": "让富人思维一点一滴的"
    },
    {
      "start": 194.04,
      "end": 195.0,
      "text": "渗透你的大脑"
    },
    {
      "start": 195.0,
      "end": 196.28,
      "text": "趁着现在还有库存"
    },
    {
      "start": 196.28,
      "end": 197.08,
      "text": "赶紧去拍"
    }
  ]
}